  <diagram id="uc2-seq" name="UC2 · LLD Transfer + Fraud Flow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2b" value="UC2 — Transfer with real-time fraud screening (latency-critical path, LLD)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="q1" value="1 · POST /transfers (Idempotency-Key, JWT)&#10;transfer-svc: validate + persist = INITIATED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="2 · transfer-svc → payment-svc&#10;create payment = PENDING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q3" value="3 · payment-svc → POST /fraud/screen&#10;(synchronous, 50 ms budget)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="q4" value="4 · fraud-svc: Redis feature store (velocity/geo/device)&#10;→ rules + model → score + reason codes → DECISION" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="d5a" value="5a · APPROVE&#10;post double-entry ledger (DEBIT/CREDIT)&#10;→ payment.processed → settle via rail = SETTLED&#10;→ notify 'transfer sent'" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="230" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5b" value="5b · REJECT&#10;payment.failed(reason=fraud) → transfer=REJECTED&#10;→ notify 'transfer blocked'&#10;→ ops-svc opens fraud case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="520" y="345" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5c" value="5c · TIMEOUT &gt; 50 ms (fail-open)&#10;mark UNSCREENED + provisional hold&#10;→ fraud.async_review → ops queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="520" y="460" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="q6" value="6 · fraud.completed emitted ALWAYS&#10;→ audit-svc (trail) + model training set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="470" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="g1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="q1" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="q2" target="q3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="q3" target="q4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4a" value="approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#82b366;" edge="1" parent="1" source="q4" target="d5a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4b" value="reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#b85450;" edge="1" parent="1" source="q4" target="d5b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g4c" value="timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#d6b656;" edge="1" parent="1" source="q4" target="d5c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="g5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="q4" target="q6"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uc2-er" name="UC2 · LLD Data Model">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3b" value="UC2 — Data model (database-per-service)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tbl_fund" value="&lt;b&gt;funding_requests&lt;/b&gt; (funding_db)&lt;hr&gt;id PK&lt;br&gt;account_id&lt;br&gt;amount / currency&lt;br&gt;source (CARD/BANK/UPI)&lt;br&gt;status&lt;br&gt;idempotency_key UK&lt;br&gt;trace_id / created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="250" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl_trf" value="&lt;b&gt;transfers&lt;/b&gt; (transfer_db)&lt;hr&gt;id PK&lt;br&gt;from_account_id&lt;br&gt;to_account_ref&lt;br&gt;amount / currency&lt;br&gt;rail (DOMESTIC/INTERNATIONAL)&lt;br&gt;status&lt;br&gt;idempotency_key UK&lt;br&gt;trace_id / created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="250" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="tbl_pay" value="&lt;b&gt;payments&lt;/b&gt; (payment_db)&lt;hr&gt;id PK&lt;br&gt;kind (FUNDING/TRANSFER)&lt;br&gt;source_ref&lt;br&gt;amount / currency&lt;br&gt;status (PENDING/PROCESSED/FAILED)&lt;br&gt;processed_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="tbl_led" value="&lt;b&gt;ledger_entries&lt;/b&gt; (payment_db)&lt;hr&gt;id PK&lt;br&gt;payment_id FK&lt;br&gt;account_id&lt;br&gt;direction (DEBIT/CREDIT)&lt;br&gt;amount&lt;br&gt;balance_after&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="250" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tbl_fdec" value="&lt;b&gt;fraud_decisions&lt;/b&gt; (fraud_db)&lt;hr&gt;id PK&lt;br&gt;payment_id&lt;br&gt;score (0-1000)&lt;br&gt;decision (APPROVE/REJECT/REVIEW)&lt;br&gt;latency_ms&lt;br&gt;model_version&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="690" y="60" width="260" height="170" as="geometry" />
        </mxCell>
        <mxCell id="tbl_fsig" value="&lt;b&gt;fraud_signals&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;decision_id FK&lt;br&gt;code (VELOCITY/GEO/AMOUNT/DEVICE/BLACKLIST)&lt;br&gt;contribution&lt;br&gt;detail" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="690" y="260" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tbl_fcase" value="&lt;b&gt;fraud_cases&lt;/b&gt; (ops)&lt;hr&gt;id PK&lt;br&gt;decision_id FK&lt;br&gt;status (OPEN/CONFIRMED/FALSE_POSITIVE/CLOSED)&lt;br&gt;assigned_to&lt;br&gt;resolution&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="690" y="440" width="260" height="160" as="geometry" />
        </mxCell>
        <mxCell id="rr1" value="1 : 1 (event)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;dashed=1;" edge="1" parent="1" source="tbl_fund" target="tbl_pay"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rr2" value="1 : 1 (event)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;dashed=1;" edge="1" parent="1" source="tbl_trf" target="tbl_pay"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rr3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_pay" target="tbl_led"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rr4" value="1 : 1 (sync)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;dashed=1;" edge="1" parent="1" source="tbl_pay" target="tbl_fdec"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rr5" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_fdec" target="tbl_fsig"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="rr6" value="1 : N (on flag)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;dashed=1;" edge="1" parent="1" source="tbl_fdec" target="tbl_fcase"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note_er2" value="Solid = FK within one service DB. Dashed = cross-service link via Kafka event or sync API (no shared FK). Money moves ONLY when a payment reaches PROCESSED (double-entry)." style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="900" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
