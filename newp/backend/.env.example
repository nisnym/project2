# ==========================================================
# PFA backend — copy to .env and edit. Every value has a
# working default, so the stack boots with no .env at all.
# ==========================================================

# --- service ports (the gateway is the only one the SPA talks to) ---
GATEWAY_PORT=8080
CUSTOMER_SERVICE_PORT=9001
TRANSACTION_SERVICE_PORT=9002
BUDGET_SERVICE_PORT=9003
INSIGHT_SERVICE_PORT=9004
CHAT_SERVICE_PORT=9005

# --- service discovery (override when running in docker/k8s) ---
CUSTOMER_SERVICE_URL=http://localhost:9001
TRANSACTION_SERVICE_URL=http://localhost:9002
BUDGET_SERVICE_URL=http://localhost:9003
INSIGHT_SERVICE_URL=http://localhost:9004
CHAT_SERVICE_URL=http://localhost:9005

# --- data ---
# Point this at a different folder to run the whole stack on a different
# bank's book of customers. Nothing about the data lives in the code.
DATA_DIR=./data
# Set true to let POST /transactions write back to the seed JSON files.
PERSIST_WRITES=false

# --- money / locale ---
CURRENCY=INR
CURRENCY_SYMBOL=₹
LOCALE=en-IN

# --- demo clock -------------------------------------------------------
# HARDCODED, AND DELIBERATE: the seeded ledger runs Jun–Aug 2026, so "today"
# is pinned to 2026-08-12 — mid-way through the last seeded month, which is
# what makes "spent so far" and "on pace to" meaningful. Set this to an empty
# string to use the real system date instead (do that once you are feeding in
# live-dated data). This is the only date the application treats as now.
DEMO_TODAY=2026-08-12

# --- chatbot (GitHub Models) -----------------------------------------
# github_sdk : OpenAI-compatible SDK pointed at GitHub Models  (recommended)
# github_cli : shells out to `gh models run`  (no token plumbing needed)
# fallback   : deterministic rule engine, no network            (always works)
CHAT_PROVIDER=fallback
GITHUB_TOKEN=
GITHUB_MODELS_BASE_URL=https://models.github.ai/inference
GITHUB_MODEL=openai/gpt-4o-mini
CHAT_TIMEOUT_SECONDS=30
CHAT_MAX_TOKENS=700
CHAT_TEMPERATURE=0.2

# --- misc ---
LOG_LEVEL=INFO
CORS_ORIGINS=*
UPSTREAM_TIMEOUT_SECONDS=8
