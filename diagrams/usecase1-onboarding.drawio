        <mxCell id="kycprov" value="External KYC / Sanctions&#10;provider (mocked)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="470" width="220" height="60" as="geometry" />
