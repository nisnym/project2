  <diagram id="uc1-seq" name="UC1 · LLD Onboarding Flow">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="UC1 — End-to-end onboarding flow (LLD)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="1 · Customer submits info&#10;POST /onboarding (JWT)&#10;→ onboarding-svc: application=CAPTURED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2 · emit customer.captured → Kafka&#10;kyc-svc consumes, opens KYC case" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="160" width="320" height="70" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3 · kyc-svc (Celery async):&#10;identity match · doc validity · sanctions/PEP&#10;→ emit kyc.completed(PASS, score)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4 · eligibility-svc consumes kyc.completed&#10;rules + risk score → decision + product tier&#10;→ emit eligibility.evaluated(PASS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5 · account-svc consumes eligibility.evaluated&#10;generates account number instantly&#10;→ emit account.opened(acct_no, ifsc, swift)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="320" height="80" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6 · onboarding-svc consumes account.opened&#10;application = ACCOUNT_OPENED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="b_notif" value="notification-svc&#10;welcome + account details&#10;(consumes account.opened)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="480" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_audit" value="audit-svc&#10;append-only hash-chained log&#10;(consumes EVERY step)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="480" y="60" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b_result" value="7 · Customer polls GET /onboarding/{id}&#10;(or WebSocket push)&#10;→ status ACCOUNT_OPENED + instant account details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="480" y="590" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="f1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="s6" target="b_result"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="s5" target="b_notif"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="s1" target="b_audit"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="uc1-er" name="UC1 · LLD Data Model">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="UC1 — Data model (database-per-service)" style="text;html=1;fontSize=16;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="tbl_app" value="&lt;b&gt;onboarding_applications&lt;/b&gt; (onboarding_db)&lt;hr&gt;id PK (uuid)&lt;br&gt;user_id FK&lt;br&gt;status (state machine)&lt;br&gt;customer_info jsonb&lt;br&gt;trace_id&lt;br&gt;created_at / updated_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tbl_appevt" value="&lt;b&gt;application_events&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;application_id FK&lt;br&gt;from_state / to_state&lt;br&gt;meta jsonb&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tbl_kyc" value="&lt;b&gt;kyc_cases&lt;/b&gt; (kyc_db)&lt;hr&gt;id PK&lt;br&gt;application_id FK&lt;br&gt;status&lt;br&gt;score&lt;br&gt;created_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tbl_kycdoc" value="&lt;b&gt;kyc_documents&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;kyc_case_id FK&lt;br&gt;doc_type (ID/ADDRESS/SELFIE)&lt;br&gt;object_key (MinIO)&lt;br&gt;status" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="240" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tbl_kycchk" value="&lt;b&gt;kyc_checks&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;kyc_case_id FK&lt;br&gt;identity_match bool&lt;br&gt;document_valid bool&lt;br&gt;sanctions_hit / pep_hit&lt;br&gt;provider_raw jsonb" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="240" height="150" as="geometry" />
        </mxCell>
        <mxCell id="tbl_elg" value="&lt;b&gt;eligibility_assessments&lt;/b&gt; (eligibility_db)&lt;hr&gt;id PK&lt;br&gt;application_id FK&lt;br&gt;risk_score (0-100)&lt;br&gt;decision (PASS/FAIL/REVIEW)&lt;br&gt;product_tier" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="60" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="tbl_rf" value="&lt;b&gt;risk_factors&lt;/b&gt;&lt;hr&gt;id PK&lt;br&gt;assessment_id FK&lt;br&gt;code&lt;br&gt;weight&lt;br&gt;description" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="660" y="230" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="tbl_acc" value="&lt;b&gt;accounts&lt;/b&gt; (account_db)&lt;hr&gt;id PK&lt;br&gt;user_id&lt;br&gt;account_number UK&lt;br&gt;ifsc / swift&lt;br&gt;currency&lt;br&gt;status (ACTIVE/FROZEN/CLOSED)&lt;br&gt;balance (cache; truth=ledger)&lt;br&gt;opened_at" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="660" y="390" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_app" target="tbl_appevt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r2" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;" edge="1" parent="1" source="tbl_app" target="tbl_kyc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r3" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_kyc" target="tbl_kycdoc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r4" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;" edge="1" parent="1" source="tbl_kyc" target="tbl_kycchk"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r5" value="1 : 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;" edge="1" parent="1" source="tbl_app" target="tbl_elg"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r6" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERmany;startArrow=ERone;" edge="1" parent="1" source="tbl_elg" target="tbl_rf"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="r7" value="1 : 1 (via event)" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=ERone;startArrow=ERone;dashed=1;" edge="1" parent="1" source="tbl_elg" target="tbl_acc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="note_er" value="Solid = FK within a service DB. Dashed = cross-service link established via Kafka event (no shared FK)." style="text;html=1;align=left;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="580" height="20" as="geometry" />
        </mxCell>
      </root>
